# ==============================================================================
# Git Ignore Configuration - PH2001 Triết học Mác - Lênin
# ==============================================================================

# --- Tệp đa phương tiện & Video dung lượng lớn (> 100 MB GitHub limit) ---
*.mp4
*.mkv
*.avi
*.mov
*.wmv
*.flv
*.webm

# Tệp nén dung lượng lớn
*.zip
*.rar
*.7z
*.tar.gz
*.iso

# --- Tệp tạm & Tệp khóa của Microsoft Office (Word, PowerPoint, Excel) ---
~$*.docx
~$*.doc
~$*.pptx
~$*.ppt
~$*.xlsx
~$*.xls
*.tmp
*.bak

# --- Tệp hệ điều hành tự động sinh ---
# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# --- Trình soạn thảo & Môi trường phát triển (IDEs & Editors) ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# --- Tệp Python & Môi trường ảo (nếu có sử dụng script xử lý tài liệu) ---
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.env
*.env
.venv/
venv/
